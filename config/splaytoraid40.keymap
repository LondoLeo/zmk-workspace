#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/ {
    #define SMOL_SPLAY
    #include "smol.dtsi"
    
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
                            &kp Q      &kp W       &kp F       &kp P          &kp B          &kp Z          &kp L          &kp U       &kp Y       &kp BSPC
                &none       &kp A      &hml LALT R &hml LGUI S &hml LCTRL T   &kp G          &kp M          &hmr RCTRL N   &hmr RGUI E &hmr RALT I &kp O    &none      
                &none       &kp J      &kp X       &kp C       &kp D          &kp V          &kp K          &kp H          &comm       &dot        &kp FSLH &none     
                                       &sk LALT    &kp  LSHFT      &blt FUN SPACE  &kp C_MUTE   &qlt NAV RET   &mo  SYM    &sk RALT  
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };
        sym_layer {
            display-name = "Sym";   
            bindings = <
                            &kp GRAVE  &kp EXCL   &equal      &minus          &kp PLUS      &kp CARET       &kp LT         &kp GT      &kp UNDER  &trans   
                &trans      &num1      &num2      &num3       &num4           &num5         &num6           &num7          &num8       &num9      &num0     &trans  
                &trans      &kp DLLR   &kp TILDE  &kp PIPE    &kp AMPS        &kp PRCNT     &none           &kp STAR       &kp BSLH    &kp COLON  &kp RA(N5)&trans  
                                          &trans  &trans      &trans  &trans  &trans        &trans          &trans
            >;
        };
        nav_layer {
            display-name = "Nav";
            bindings = <
                            &none       &none       &kp HOME   &kp END        &none         &none           &kp LG(LEFT)   &kp LG(RIGHT)&none      &kp DEL 
                &none       &none       &sk LALT    &sk LCMD   &sk LCTRL      &none         &kp LEFT        &kp DOWN       &kp UP       &kp RIGHT  &kp LC(S)&none
                &none       &none       &none       &kp PG_UP  &kp PG_DN      &none         &none           &kp LA(LEFT)   &kp LA(RIGHT)&none      &none    &none
                                                   &trans  &trans    &trans   &trans   &trans     &trans          &trans
            >;
        };
        function_layer {
            display-name = "Func";
            bindings = <
                            &kp LC(N1)    &kp LC(N2)   &kp LC(N3)   &kp LC(N4)    &kp LC(N5)    &rgb_ug RGB_TOG &none          &none        &none      &none 
                &none       &kp CG(N1)    &kp CG(N2)   &kp CG(N3)   &kp CG(N4)    &kp CG(N5)    &kp C_MUTE      &kp C_VOL_DN   &kp C_VOL_UP &none      &none  &none
                &none       &none         &none        &kp LC(PG_UP)&kp LC(PG_DN) &kp CG(W)     &none           &kp C_PP       &kp C_NEXT   &none      &none  &none
                                                &trans     &trans   &trans  &trans      &trans        &trans    &trans
            >;
        };
        system_layer {
            display-name = "Sys";
            bindings = <
                            &none        &none          &none        &none          &none         &kp F1    &kp F2        &kp F3       &kp F4       &kp F5        
                &none       &none        &none          &none        &none          &none         &kp F6    &kp F7        &kp F8       &kp F9       &kp F10     &none
                &none       &none        &none          &none        &none          &none         &kp F11   &kp F12       &none        &none        &bootloader &none
                                                &trans  &trans   &trans    &trans         &trans        &trans          &trans
            >;
        };
    };
};
